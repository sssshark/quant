# Python 缓存
__pycache__/
*.pyc

# Claude 本地配置（含机器相关的本地设置，不入仓库）
.claude/settings.local.json

# 运行时状态（实盘/模拟盘账户与调仓记录，随运行变化，不入仓库）
paper_account.json
last_rebalance.txt

# 回测产出的图（可由 engine.py / bt_recent.py 重新生成；engine 全周期 + bt_recent 近 N 年窗口）
ETF动量轮动_*.png

# tushare 凭证（本地持有，不入仓库；_load_via_tushare 在环境变量缺失时回退读它）
.tushare_token

# 实盘凭证（本地持有，不入仓库；etf_momentum_live._load_live_secret 在环境变量缺失时读它）
# 样例见 live_config.example.json
live_config.json

# 美股 ETF 日线 CSV（J1 跨市场验证用；用户从外部源导出后放入，不入仓库）
# crossmarket.load_us_etfs 在 stooq/yfinance 不可用时回退读这里
usdata/
